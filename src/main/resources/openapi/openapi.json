  "components" : {
    "schemas" : {
      "DomainLockRequest" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "maxLength" : 2048,
            "minLength" : 0,
            "type" : "string"
          },
          "idempotencyKey" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "OwncastModRequest" : {
        "type" : "object",
        "properties" : {
          "reason" : {
            "maxLength" : 2048,
            "minLength" : 0,
            "type" : "string",
            "nullable" : true
          }
        }
      },
      "RecommendRequest" : {
        "required" : [ "kind", "target" ],
        "type" : "object",
        "properties" : {
          "kind" : {
            "minLength" : 1,
            "pattern" : "instance-block|user-removal",
            "type" : "string"
          },
          "target" : {
            "maxLength" : 512,
            "minLength" : 0,
            "type" : "string"
          },
          "reason" : {
            "maxLength" : 2048,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "SeedRequest" : {
        "type" : "object",
        "properties" : {
          "surface" : {
            "maxLength" : 64,
            "minLength" : 0,
            "type" : "string"
          },
          "disposition" : {
            "pattern" : "flagged|rejected",
            "type" : "string"
          }
        }
      },
      "SystemFindingDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "reporter" : {
            "type" : "string"
          },
          "subject" : {
            "type" : "string"
          },
          "surface" : {
            "type" : "string"
          },
          "disposition" : {
            "type" : "string"
          },
          "classification" : {
            "type" : "string"
          },
          "confidence" : {
            "type" : "number",
            "format" : "double"
          },
          "policyHit" : {
            "type" : "boolean"
          },
          "perceptualHash" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "reviewer" : {
            "type" : "string"
          },
          "ts" : {
            "type" : "string",
            "format" : "date-time"
          },
          "domain" : {
            "type" : "string"
          }
        }
      },
      "BlockRequest" : {
        "required" : [ "platform", "scope", "target" ],
        "type" : "object",
        "properties" : {
          "platform" : {
            "minLength" : 1,
            "pattern" : "(?i)matrix|mastodon",
            "type" : "string"
          },
          "scope" : {
            "minLength" : 1,
            "pattern" : "(?i)user|instance",
            "type" : "string"
          },
          "target" : {
            "maxLength" : 512,
            "minLength" : 0,
            "type" : "string"
          },
          "reason" : {
            "maxLength" : 2048,
            "minLength" : 0,
            "type" : "string"
          }
        }
      },
      "BanRequest" : {
        "required" : [ "platform", "target" ],
        "type" : "object",
        "properties" : {
          "platform" : {
            "minLength" : 1,
            "pattern" : "(?i)matrix|mastodon|profile",
            "type" : "string"
          },
          "target" : {
            "maxLength" : 400,
            "minLength" : 0,
            "type" : "string"
          },
          "ttlSeconds" : {
            "type" : "integer",
