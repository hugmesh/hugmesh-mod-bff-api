          },
          "400" : {
            "description" : "Validation failed — missing/invalid field"
          },
          "401" : {
            "description" : "Unauthenticated"
          },
          "403" : {
            "description" : "Caller lacks ROLE_MOD or ROLE_ADMIN"
          },
          "500" : {
            "description" : "Unexpected server error"
          }
        }
      }
    },
    "/bff/mod/moderation/{id}/refer" : {
