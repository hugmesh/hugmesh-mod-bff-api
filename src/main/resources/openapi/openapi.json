  },
  "servers" : [ {
    "url" : ""
  } ],
  "tags" : [ {
    "name" : "Moderator",
    "description" : "MOD/ADMIN-gated moderation triage, refer-to-admin escalation, server-wide Matrix/Mastodon block (audited), and federation module delivery."
  }, {
    "name" : "Moderator status",
    "description" : "Polling endpoint for the caller's own moderator role status."
  }, {
    "name" : "System Findings (TEST-SEED)",
    "description" : "TEST/SEED-ONLY. Ships dark behind app.test-seed.enabled (default false). Files a real HELD system finding, owned by the calling MOD/ADMIN, through the SAME federation-api production write path the pre-publish edge-AI vision check uses — never a parallel write."
  } ],
  "paths" : {
    "/bff/mod/domain-lock/{role}/{user}" : {
      "post" : {
        "tags" : [ "Moderator" ],
        "summary" : "Domain-lock a user (force local-only; writes desired-state → 202 pending-reconcile).",
        "operationId" : "domainLockUser",
        "parameters" : [ {
          "name" : "role",
          "in" : "path",
          "required" : true,
          "schema" : {
            "pattern" : "ROLE_MATRIX_DOMAINLOCKED|ROLE_MASTODON_DOMAINLOCKED",
            "type" : "string"
          }
        }, {
          "name" : "user",
          "in" : "path",
          "required" : true,
          "schema" : {
            "maxLength" : 400,
            "minLength" : 0,
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DomainLockRequest"
              }
            }
          }
        },
        "responses" : {
          "202" : {
            "description" : "Pending-reconcile — domain-lock desired-state written",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "object"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid role path variable"
          },
          "401" : {
            "description" : "Unauthenticated"
          },
          "403" : {
            "description" : "Self-lock, privileged target, or cross-tenant attempt denied"
          },
          "500" : {
            "description" : "Unexpected server error"
          }
        }
      },
      "delete" : {
        "tags" : [ "Moderator" ],
        "summary" : "Domain-unlock a user (clears desired-state → 202 pending-reconcile).",
        "operationId" : "domainUnlockUser",
        "parameters" : [ {
          "name" : "role",
          "in" : "path",
          "required" : true,
          "schema" : {
            "pattern" : "ROLE_MATRIX_DOMAINLOCKED|ROLE_MASTODON_DOMAINLOCKED",
            "type" : "string"
          }
        }, {
          "name" : "user",
          "in" : "path",
          "required" : true,
          "schema" : {
            "maxLength" : 400,
            "minLength" : 0,
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DomainLockRequest"
              }
            }
          }
        },
        "responses" : {
          "202" : {
            "description" : "Pending-reconcile — domain-lock desired-state cleared",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "object"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid role path variable"
          },
          "401" : {
            "description" : "Unauthenticated"
          },
          "403" : {
            "description" : "Self-unlock or cross-tenant attempt denied"
          },
          "500" : {
            "description" : "Unexpected server error"
          }
        }
      }
    },
